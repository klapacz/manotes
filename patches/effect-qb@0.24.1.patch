diff --git a/src/sqlite/column-extension.ts b/src/sqlite/column-extension.ts
index 2fcc08e1e910b39d1859bb297b0fb4c89893d32f..e8c4f0e8a728ee89dff76e114ef11a94f11896c2 100644
--- a/src/sqlite/column-extension.ts
+++ b/src/sqlite/column-extension.ts
@@ -1,3 +1,21 @@
 export { custom } from "./column.js"
 
 export type { Any, AnyBound } from "./column.js"
+
+import { ColumnTypeId, remapColumnDefinition, type AnyColumnDefinition } from "../internal/column-state.js"
+import type { HasDefaultColumn } from "../internal/column.js"
+
+/** SQLite INTEGER PRIMARY KEY AUTOINCREMENT; omitting the value allocates a row ID. */
+export const autoIncrement = <C extends AnyColumnDefinition>(
+  column: C[typeof ColumnTypeId]["primaryKey"] extends true
+    ? C["metadata"]["dbType"]["kind"] extends "int" ? C : never
+    : never
+): HasDefaultColumn<C> => {
+  if (!column.metadata.primaryKey || column.metadata.dbType.kind !== "int" || column.metadata.generated) {
+    throw new Error("SQLite AUTOINCREMENT requires an integer primary key")
+  }
+  return remapColumnDefinition(column as AnyColumnDefinition, {
+    schema: column.schema.annotate({ "effect-db/sqlite/autoIncrement": true }),
+    metadata: { ...column.metadata, hasDefault: true, defaultValue: undefined, ddlType: "integer" }
+  }) as HasDefaultColumn<C>
+}
