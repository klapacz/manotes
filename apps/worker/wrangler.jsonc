{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manotes-sand",
  "compatibility_date": "2026-03-01",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./src/index.ts",
  "routes": [
    {
      "pattern": "sand.manotes.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    "ACCESS_TEAM_DOMAIN": "klapacz.cloudflareaccess.com",
    "ACCESS_AUD": "b2965dda7282615f5deb119c72292be21cc1097184d84a5189bf0de701c3d78c",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ACCOUNTS_DO",
        "class_name": "AccountsDurableObject",
      },
      {
        "name": "GRAPH_SYNC_DO",
        "class_name": "GraphSyncDurableObject",
      },
      {
        "name": "GRAPH_REGISTRY_DO",
        "class_name": "GraphRegistryDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GraphSyncDurableObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GraphRegistryDurableObject"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["AccountsDurableObject"],
    },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
