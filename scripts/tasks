#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)/.tasks"

if [[ "${1:-}" == -- ]]; then
  shift
  exec "$@"
fi

if (( $# )); then
  exec cat -- "$1.md"
fi

exec manotes execute <<'JS'
const states = [
  ["in-progress", "In progress"],
  ["todo", "Todo"],
];
const priorities = ["urgent", "high", "mid", "low"];
const records = await api.list({
  filter: [
    { _tag: "cmp", val: ["_tag", "=", "note"] },
    {
      _tag: "or",
      val: states.map(([state]) => ({
        _tag: "cmp",
        val: [["link", "->", `state:${state}`], "exists", true],
      })),
    },
  ],
});
const tasks = records.flatMap((item) => {
  if (!item.title?.startsWith("task:")) return [];

  const state = linked(item, "state");
  const priority = linked(item, "priority");

  if (state === undefined || priority === undefined) return [];

  return [{ ...item, state, priority }];
});

for (const [state, label] of states) {
  const group = tasks
    .filter((task) => task.state === state)
    .sort((a, b) =>
      priorities.indexOf(a.priority) - priorities.indexOf(b.priority) ||
      a.title.localeCompare(b.title),
    );

  console.log(`${label} (${group.length})\n`);

  for (const task of group) {
    const snippet = task.snippets.join("\n\n").replaceAll("\n", "\n  ");
    console.log(`${task.title} ${task.id} ${task.date}\n\n  ${snippet}\n`);
  }
}

// State and priority links live in the task's first content block.
function linked(item, kind) {
  return item.snippets[0]?.match(
    new RegExp(`\\]\\(\\./${kind}(?:%3[Aa]|:)([^)]+)\\.md\\)`),
  )?.[1];
}
JS
