#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)/.tasks"

if [[ "${1:-}" == -- ]]; then
  shift
  exec "$@"
fi

if (( $# )); then
  {
    printf 'const id = %s;\n' "$(node -e 'process.stdout.write(JSON.stringify(process.argv[1]))' -- "$1")"
    cat <<'RECORD_JS'
const records = await api.list({
  filter: /^[A-Z]{4}$/.test(id)
    ? [
        { _tag: "cmp", val: [["prop", "prop:kind"], "=", { _tag: "enum", val: "option:kind:task" }] },
        { _tag: "cmp", val: [["prop", "prop:id"], "=", { _tag: "text", val: id }] },
      ]
    : [{ _tag: "cmp", val: ["id", "=", id] }],
});
if (records.length === 0) throw new Error(`Record not found: ${id}`);
if (records.length > 1) throw new Error(`Duplicate task ID: ${id}`);
await api.showList("full", records);
RECORD_JS
  } | manotes execute
  exit
fi

exec manotes execute <<'JS'
const states = [
  ["in-progress", "🚧 In progress"],
  ["todo", "📋 Todo"],
];
const priorities = ["urgent", "high", "mid", "low"].map((value) => `option:priority:${value}`);
const records = await api.list({
  filter: [
    { _tag: "cmp", val: ["_tag", "=", "note"] },
    { _tag: "cmp", val: [["prop", "prop:kind"], "=", { _tag: "enum", val: "option:kind:task" }] },
    { _tag: "cmp", val: [["prop", "builtin:archived"], "=", { _tag: "bool", val: false }] },
    {
      _tag: "or",
      val: states.map(([state]) => ({
        _tag: "cmp",
        val: [["prop", "prop:state"], "=", { _tag: "enum", val: `option:state:${state}` }],
      })),
    },
  ],
});
const tasks = records.flatMap((item) => {
  const state = propValue(item, "prop:state", "enum");
  const priority = propValue(item, "prop:priority", "enum");

  if (state === undefined || priority === undefined) return [];

  return [{ ...item, state, priority }];
});

for (const [state, label] of states) {
  const group = tasks
    .filter((task) => task.state === `option:state:${state}`)
    .sort((a, b) =>
      (priorities.includes(a.priority) ? priorities.indexOf(a.priority) : priorities.length) -
        (priorities.includes(b.priority) ? priorities.indexOf(b.priority) : priorities.length) ||
      (a.title ?? a.id).localeCompare(b.title ?? b.id),
    );

  console.log(`${label} (${group.length})\n`);

  for (const task of group) {
    const snippet = task.snippets.join("\n\n").replaceAll("\n", "\n  ");
    const code = propValue(task, "prop:id", "text") ?? "No ID";
    const project = task.props.top.find((entry) => entry.propId === "prop:project")?.value.label ?? "Unassigned";
    const priority = task.props.top.find((entry) => entry.propId === "prop:priority")?.value.label ?? "Unassigned";
    console.log(`${code} ${task.title ?? "Untitled"} ${task.date}\n  ${project} · ${priority}\n\n  ${snippet}\n`);
  }
}

function propValue(item, propId, type) {
  const state = item.props.top.find((entry) => entry.propId === propId)?.value.state;
  return state?._tag === "Valid" && state.value._tag === type ? state.value.val : undefined;
}
JS
