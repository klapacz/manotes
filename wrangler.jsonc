{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manotes",
  "compatibility_date": "2026-03-01",
  "main": "./src/server/index.ts",
  "durable_objects": {
    "bindings": [
      {
        "name": "GRAPH_SYNC_DO",
        "class_name": "GraphSyncDurableObject",
      },
      {
        "name": "GRAPH_REGISTRY_DO",
        "class_name": "GraphRegistryDurableObject",
      },
    ],
  },
  "vars": {
    "ACCOUNT_ID": "single-user"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GraphSyncDurableObject"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["GraphRegistryDurableObject"],
    },
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
