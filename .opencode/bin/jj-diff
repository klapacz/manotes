#!/usr/bin/env bun
// Filtered jj diff - excludes noisy generated/lock files
// Usage: .opencode/bin/jj-diff [revision] [extra-args...]

import { EXCLUDE_FILTER } from "../lib/jj-filters";

const [rev = "@", ...extraArgs] = Bun.argv.slice(2);

const proc = Bun.spawn(
  ["jj", "diff", "-r", rev, "--git", EXCLUDE_FILTER, ...extraArgs],
  {
    stdout: "inherit",
    stderr: "inherit",
  },
);

process.exit(await proc.exited);
