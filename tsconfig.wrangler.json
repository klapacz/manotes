    "src/lib/event.schema.ts",
    "src/lib/graph-encryption.ts",
    "src/lib/opfs.service.ts",
    "src/lib/sql-sqlite-wasm/sqlite-client.ts",
    "src/lib/sql-sqlite-wasm/internal/opfs-worker.ts",
  ],
